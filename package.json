{
  "name": "barkdown-handoff",
  "version": "0.5.0",
  "private": true,
  "description": "Barkdown product specification, interactive concepts, and implementation handoff",
  "engines": { "node": ">=22.13.1" },
  "scripts": {
    "build": "node scripts/build.cjs",
    "preview": "node scripts/preview.cjs",
    "check": "tsc -p tsconfig.json && node scripts/check.cjs",
    "test": "node scripts/test.cjs",
    "verify": "npm run build && npm run check && npm test"
  },
  "devDependencies": {
    "cheerio": "1.2.0",
    "lucide": "1.8.0",
    "playwright": "1.62.1",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "5.9.3"
  }
}
