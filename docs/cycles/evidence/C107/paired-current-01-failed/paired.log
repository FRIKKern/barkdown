{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}, %{"description" => "A crit doubles the rolled damage. combat.gd CRIT_MULTIPLIER 2.0 (mirrors PlayerStats.crit_multiplier / BASE_CRIT_MULTIPLIER).", "name" => "critMult", "title" => "Crit multiplier", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}, %{"description" => "Probability a shot crits before Crit-stat points. PlayerStats.BASE_CRIT_CHANCE 0.25 (+0.20 per Crit point, clamped 1.0).", "name" => "critChance", "title" => "Base crit chance (0..1)", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}, %{"description" => "The ordered multiplicative stack the per-shot damage passes through in combat.gd before round() is applied EXACTLY ONCE. All entries are identity (x1.0) when their condition is unmet, so a grounded still point-blank body shot is unchanged.", "name" => "damageChain", "of" => %{"name" => "multiplier", "title" => "Multiplier name", "type" => "string"}, "ordered" => true, "title" => "Damage chain (teaching field)", "type" => "arrayOf"}, %{"description" => "When fireMode is projectile, the projectileType this weapon spawns. Null/unset for the hitscan machine gun.", "name" => "projectile", "refType" => "projectileType", "title" => "Projectile type", "type" => "reference"}], false, "document", [], "becd7db3-7981-48b9-810d-6b4f275793fa", "82d83e14-9ab7-435e-a15a-8926c74d8602", "production", [], "send", [], "66516016-9a7d-4314-b533-10bb3e752460", "private", [], [], %{"baseDamage" => "4.0", "baseFireRate" => "0.089", "critChance" => "0.25", "critMult" => "2.0", "damageChain" => ["stat_dmg", "floor_dmg", "doomblaster", "slide", "dash", "headshot", "crit"], "fireMode" => "hitscan", "headshotMult" => "4.0", "maxRange" => "100.0", "title" => "Machine Gun"}, [], %{}, %{}, false, %{}, ~U[2026-10-14 01:34:55.290495Z], ~U[2026-10-14 01:34:55.290495Z], "1311de25-b962-4d09-8ebf-61e0d46af823"]
