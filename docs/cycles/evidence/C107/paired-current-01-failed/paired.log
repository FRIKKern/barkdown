me" => "bossWaves", "of" => %{"name" => "bossWave", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}, "ordered" => true, "title" => "Boss-wave positions", "type" => "arrayOf"}, %{"description" => "The royals spawned at each boss wave, in order (Prince -> Queen -> King). References the bossType schema.", "name" => "bossSequence", "of" => %{"name" => "boss", "refType" => "bossType", "type" => "reference"}, "ordered" => true, "title" => "Boss sequence", "type" => "arrayOf"}, %{"description" => "Per-floor enemy HP/damage scaling curve. Source getFloorScaling HP 1.3^(floor-1).", "name" => "hpCurve", "refType" => "scalingCurve", "title" => "HP scaling curve", "type" => "reference"}, %{"description" => "Per-floor enemy count scaling curve. Source getFloorScaling count 1.2^(floor-1).", "name" => "countCurve", "refType" => "scalingCurve", "title" => "Count scaling curve", "type" => "reference"}, %{"description" => "Per-level XP requirement scaling curve.", "name" => "xpCurve", "refType" => "scalingCurve", "title" => "XP scaling curve", "type" => "reference"}], false, "document", [], "becd7db3-7981-48b9-810d-6b4f275793fa", "82d83e14-9ab7-435e-a15a-8926c74d8602", "production", [], "compass", [], "66516016-9a7d-4314-b533-10bb3e752460", "private", [], [], %{"autoWaveInterval" => "20", "bossWaves" => ["4", "7", "10"], "earlyClearDelay" => "2", "floorIntroDelay" => "4", "title" => "Default Run", "wavesPerFloor" => "10"}, [], %{}, %{}, false, %{}, ~U[2026-10-14 01:34:55.316761Z], ~U[2026-10-14 01:34:55.316761Z], "8ab68fae-af88-44d4-bdf3-08c6896ef1ea"]
