unt", "title" => "Count (uses)", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}], "name" => "cost", "title" => "Cost", "type" => "composite"}, %{"description" => "Movement-speed multiplier applied while the ability is active (e.g. focus-dash ×4, slide opens at SLIDE_SPEED 13). 1.0 = no change.", "name" => "speedMult", "title" => "Speed multiplier", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}, %{"description" => "Additive camera FOV change while active (e.g. aim −10 from base 75 to 65, slide +15 to 90). Source camera_rig.gd FOV_* consts.", "name" => "fovDelta", "title" => "FOV delta (deg)", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}, %{"description" => "Fractional bonus to gun damage while the ability is active (e.g. slide +0.25, dash +0.40). 0 = no bonus.", "name" => "damageBonus", "title" => "Damage bonus (fraction)", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}, %{"description" => "How long the ability's effect lasts (e.g. focus-dash 0.5s, super-jump free slowmo 3.0s). 0 for instantaneous / held abilities.", "name" => "duration", "title" => "Duration (s)", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}, %{"description" => "The GameClock time state this ability drives, if any (e.g. focus-dash → FOCUS_DASH 0.25× scale, bullet-time → SLOW_MO). References the timeState schema.", "name" => "usesTimeState", "refType" => "timeState", "title" => "Uses time state", "type" => "reference"}], false, "document", [], "production", [], "activity", [], "private", [], [], %{}, [], %{}, %{}, false, %{}, ~U[2026-10-14 01:34:55.282018Z], ~U[2026-10-14 01:34:55.282018Z], "52e9a714-a91e-48e6-bea3-23b9c8135dba"]
