              "cloud site open") __bppath=('--print-only');;
              "cloud site preflight") __bppath=('--dir' '--skip-build');;
              "cloud site rm") __bppath=('--yes');;
              "cloud site settings") __bppath=('--doc-type' '--prebuilt-enabled' '--theme');;
              "cloud site status") __bppath=('--window');;
              "cloud sites") __bppath=('build' 'create' 'delete' 'deploy' 'deployments' 'deploys' 'doctor' 'domain' 'domains' 'env' 'get' 'github' 'list' 'log' 'logs' 'ls' 'matrix' 'open' 'preflight' 'rm' 'rollback' 'settings' 'show' 'status');;
