INSERT INTO schema_definitions
SELECT (
  jsonb_populate_record(
    NULL::schema_definitions,
    src.survivor || jsonb_build_object(
      'id', gen_random_uuid(),
      'dataset', 'paperflow',
      'dataset_id', $2::uuid,
      'inserted_at', now(),
      'updated_at', now()
    )
  )
).*
FROM (
  SELECT to_jsonb(s.*) AS survivor
