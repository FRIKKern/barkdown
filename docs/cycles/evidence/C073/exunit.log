01:39:47.864 [debug] QUERY OK db=2.4ms
INSERT INTO documents (id, doc_id, type, dataset, title, status, content, rev, inserted_at, updated_at)
SELECT
  gen_random_uuid(),
  p.slug,
  'paper',
  p.dataset,
  COALESCE(
    (
      SELECT b->>'text'
      FROM jsonb_array_elements(COALESCE(p.blocks_val, '[]'::jsonb)) AS b
      WHERE b->>'type' = 'heading' AND COALESCE(b->>'text', '') <> ''
      LIMIT 1
    ),
    p.slug
  ),
  'published',
  (
    jsonb_strip_nulls(
      jsonb_build_object(
        'body_html', COALESCE(p.body_html, ''),
        'blocks', p.blocks_val,
        'source_doc', p.source_doc_val,
        'goal_id', p.goal_id_val,
        'event_type', p.event_type_val
      )
    )
    || jsonb_build_object('rev', p.rev_val)
  ),
  md5(random()::text || clock_timestamp()::text),
  p.inserted_at,
  p.updated_at
FROM (
  SELECT
    slug,
    dataset,
    body_html,
    blocks AS blocks_val,
    source_doc AS source_doc_val,
    goal_id AS goal_id_val,
    event_type AS event_type_val,
    (GREATEST(COALESCE(rev, 0), 1)) AS rev_val,
    inserted_at,
    updated_at
  FROM papers
) p
ON CONFLICT (doc_id, type, dataset) DO NOTHING
 []

