e chase distance.", "name" => "stances", "of" => %{"fields" => [%{"description" => "Which over-shoulder framing this stance represents. Source camera_rig.gd framing-cycle presets (all TPS chase, never first-person).", "name" => "stance", "options" => ["right", "left", "wide"], "title" => "Stance", "type" => "select"}, %{"description" => "Additive FOV change for this stance vs the preset's base FOV.", "name" => "fovDelta", "title" => "FOV delta (deg)", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}, %{"description" => "Chase distance for this stance. RIGHT/LEFT 3.0, WIDE 4.5.", "name" => "distance", "title" => "Chase distance (m)", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}], "type" => "composite"}, "ordered" => true, "title" => "Stances", "type" => "arrayOf"}], false, "document", [], "production", [], "eye", [], "private", [], [], %{"distance" => "3.0", "fov" => "75", "sensitivityMult" => "1.0", "shoulderOffset" => "0.6", "stances" => [%{"distance" => "3.0", "fovDelta" => "0", "stance" => "right"}, %{"distance" => "3.0", "fovDelta" => "0", "stance" => "left"}, %{"distance" => "4.5", "fovDelta" => "0", "stance" => "wide"}], "title" => "Right shoulder"}, [], %{}, %{}, false, %{}, ~U[2026-10-13 18:15:56.694168Z], ~U[2026-10-13 18:15:56.694168Z], "74486251-36af-4e6c-9cfa-56b16d489bcd"]
