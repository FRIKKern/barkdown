BILITY_DURATION) with bursts ramping toward the machine-gun cap; missile ability window 1.5s. Devour warning lead 10.0s before the sweep.", "name" => "cadence", "title" => "Cadence (s)", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}, %{"description" => "The projectile type this ability spawns (missiles / laser beam). Null for non-projectile abilities (summonReinforcements, devour).", "name" => "projectile", "refType" => "projectileType", "title" => "Projectile", "type" => "reference"}], "Boss Ability", false, "document", [], "5fd99805-55b0-4b4a-b7dd-c520f4a55849", "5ac3e9cd-90b0-4d1f-b2c7-26e8b2e118c5", "production", [], "activity", [], "e22b02a5-ec4a-4a4e-a89d-9025415c67d3", "private", [], [], %{"cadence" => "1.5", "cooldown" => "2.7", "count" => "4", "kind" => "missileBarrage", "slug" => "missile-barrage", "title" => "Missile Barrage"}, [], %{}, %{}, false, %{}, ~U[2026-10-13 18:45:12.363483Z], ~U[2026-10-13 18:45:12.363483Z], "8cc3f32a-80a6-41c8-8c68-f7dd95ac0bb7"]
