"A crit doubles the rolled damage. combat.gd CRIT_MULTIPLIER 2.0 (mirrors PlayerStats.crit_multiplier / BASE_CRIT_MULTIPLIER).", "name" => "critMult", "title" => "Crit multiplier", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}, %{"description" => "Probability a shot crits before Crit-stat points. PlayerStats.BASE_CRIT_CHANCE 0.25 (+0.20 per Crit point, clamped 1.0).", "name" => "critChance", "title" => "Base crit chance (0..1)", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}, %{"description" => "The ordered multiplicative stack the per-shot damage passes through in combat.gd before round() is applied EXACTLY ONCE. All entries are identity (x1.0) when their condition is unmet, so a grounded still point-blank body shot is unchanged.", "name" => "damageChain", "of" => %{"name" => "multiplier", "title" => "Multiplier name", "type" => "string"}, "ordered" => true, "title" => "Damage chain (teaching field)", "type" => "arrayOf"}, %{"description" => "When fireMode is projectile, the projectileType this weapon spawns. Null/unset for the hitscan machine gun.", "name" => "projectile", "refType" => "projectileType", "title" => "Projectile type", "type" => "reference"}], "Weapon", false, "document", [], "5fd99805-55b0-4b4a-b7dd-c520f4a55849", "5ac3e9cd-90b0-4d1f-b2c7-26e8b2e118c5", "production", [], "send", [], "e22b02a5-ec4a-4a4e-a89d-9025415c67d3", "private", [], [], %{"baseDamage" => "4.0", "baseFireRate" => "0.089", "critChance" => "0.25", "critMult" => "2.0", "damageChain" => ["stat_dmg", "floor_dmg", "doomblaster", "slide", "dash", "headshot", "crit"], "fireMode" => "hitscan", "headshotMult" => "4.0", "maxRange" => "100.0", "title" => "Machine Gun"}, [], %{}, %{}, false, %{}, ~U[2026-10-13 18:45:12.338822Z], ~U[2026-10-13 18:45:12.338822Z], "148646f0-fcdf-459b-a822-67c036679863"]
