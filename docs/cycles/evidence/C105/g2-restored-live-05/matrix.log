", "type" => "string"}, %{"description" => "Body / data typeface for HUD readouts and menu copy.", "name" => "body", "title" => "Body font", "type" => "string"}], "name" => "fonts", "title" => "Fonts", "type" => "composite"}], "Theme", false, "document", [], "5fd99805-55b0-4b4a-b7dd-c520f4a55849", "5ac3e9cd-90b0-4d1f-b2c7-26e8b2e118c5", "production", [], "palette", [], "e22b02a5-ec4a-4a4e-a89d-9025415c67d3", "private", [], [], %{"accent" => "#00ffff", "fonts" => %{"body" => "Inter", "heading" => "Rajdhani"}, "palette" => [%{"color" => "#101830", "name" => "dusk-sky"}, %{"color" => "#2143a3", "name" => "floor-accent"}, %{"color" => "#ffd666", "name" => "beacon-gold"}, %{"color" => "#ff1100", "name" => "beacon-red"}, %{"color" => "#ffd973", "name" => "mote-gold"}, %{"color" => "#4dd9ff", "name" => "mote-cyan"}, %{"color" => "#b366f2", "name" => "mote-purple"}, %{"color" => "#1a1a28", "name" => "silhouette"}], "title" => "FRT Neon"}, [], %{}, %{}, false, %{}, ~U[2026-10-13 18:45:12.442786Z], ~U[2026-10-13 18:45:12.442786Z], "4a7d3961-747d-4f08-9fca-2bf4d38c6081"]
