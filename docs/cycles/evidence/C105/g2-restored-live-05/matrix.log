2026-10-13T18:45:11.5391126Z 18:45:11.537 [info] execute "CREATE INDEX IF NOT EXISTS documents_public_search_vector_idx\nON documents USING GIN (public_search_vector)\nWHERE public_search_vector IS NOT NULL\n"
