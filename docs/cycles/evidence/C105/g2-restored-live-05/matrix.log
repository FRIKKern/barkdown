ce607da", "70429681-5ef8-4d05-882f-844dc453fc06", "ISBN-13", "13-character ISBN of a manifestation of work, when this is the only work identifier available (13 digits, without spaces or hyphens)", "eng", ~U[2026-10-13 18:45:12.940697Z], ~U[2026-10-13 18:45:12.940697Z], "07534c72-467b-4efd-a097-508828d05c8d", "82e9e517-331b-48d8-95cc-48fe17c91ba5", "ISRC", "International Standard Recording Code", "eng", ~U[2026-10-13 18:45:12.940697Z], ~U[2026-10-13 18:45:12.940697Z], "afdc46a6-41d8-44c3-a9a0-bf5d03e01a3b", "aaa14d5f-f08e-47d5-b727-e805ff689d70", "EIDR Content ID", "Entertainment Identifier Registry identifier for an audiovisual work, eg a movie, TV series (a DOI beginning ‘10.5240/’ with a suffix of 21 hexadecimal digits and five hyphens, and without https://doi.org/ or the older http://dx.doi.org/). See ui.eidr.org/search. Only for use in ONIX 3.0 or later", "eng", ~U[2026-10-13 18:45:12.940697Z], ~U[2026-10-13 18:45:12.940697Z], "c8ff7eed-cb82-43ac-8992-a44c2e8339ab", "52e53728-6c8c-4be4-b6dc-1abbbccbff4e", ...]
