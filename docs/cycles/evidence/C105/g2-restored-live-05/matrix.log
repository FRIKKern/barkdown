2026-10-13T18:45:12.3128831Z SELECT s0."id", s0."name", s0."title", s0."icon", s0."visibility", s0."owner_scoped", s0."singleton", s0."kind", s0."fields", s0."dataset", s0."cors_origins", s0."actions", s0."groups", s0."desk_groups", s0."list_preview", s0."desk", s0."initial_values", s0."cross_validations", s0."layout", s0."prefill", s0."workspace_id", s0."project_id", s0."dataset_id", s0."inserted_at", s0."updated_at" FROM "schema_definitions" AS s0 WHERE (s0."name" = $1) AND ((s0."dataset_id" = $2) OR ((s0."dataset_id" IS NULL) AND (s0."dataset" = $3))) ORDER BY s0."dataset_id" ASC NULLS LAST LIMIT 1 ["coordinatorLoop", "e22b02a5-ec4a-4a4e-a89d-9025415c67d3", "production"]
