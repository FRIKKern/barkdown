 "Per-stack damage contribution (e.g. Doomblaster +2.0/stack, Slideshow/Super Dash +0.10/stack).", "name" => "mult", "title" => "Per-stack damage term", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}, %{"description" => "Free-text clarification (e.g. \"slower fire rate trade-off\", \"scales with slide speed\", \"only while dashing\").", "name" => "note", "title" => "Note", "type" => "text"}], "name" => "damageProfile", "title" => "Damage profile", "type" => "composite"}, %{"description" => "The weapon this rune's effect attaches to (the gun/kick the multiplier folds into).", "name" => "modifies", "refType" => "weapon", "title" => "Modifies weapon", "type" => "reference"}], false, "document", [], "production", [], "package", [], "private", [], [], %{}, [], %{}, %{}, false, %{}, ~U[2026-10-13 19:47:24.255051Z], ~U[2026-10-13 19:47:24.255051Z], "09b2c08f-10b9-4f1d-8a86-69bc093b412b"]
