ption" => "A crit doubles the rolled damage. combat.gd CRIT_MULTIPLIER 2.0 (mirrors PlayerStats.crit_multiplier / BASE_CRIT_MULTIPLIER).", "name" => "critMult", "title" => "Crit multiplier", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}, %{"description" => "Probability a shot crits before Crit-stat points. PlayerStats.BASE_CRIT_CHANCE 0.25 (+0.20 per Crit point, clamped 1.0).", "name" => "critChance", "title" => "Base crit chance (0..1)", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}, %{"description" => "The ordered multiplicative stack the per-shot damage passes through in combat.gd before round() is applied EXACTLY ONCE. All entries are identity (x1.0) when their condition is unmet, so a grounded still point-blank body shot is unchanged.", "name" => "damageChain", "of" => %{"name" => "multiplier", "title" => "Multiplier name", "type" => "string"}, "ordered" => true, "title" => "Damage chain (teaching field)", "type" => "arrayOf"}, %{"description" => "When fireMode is projectile, the projectileType this weapon spawns. Null/unset for the hitscan machine gun.", "name" => "projectile", "refType" => "projectileType", "title" => "Projectile type", "type" => "reference"}], false, "document", [], "db91ad5f-3bbe-498d-8ed8-9764a8959396", "d08684a3-edfe-411c-aa4a-2b592f46269b", "production", [], "send", [], "148a5cbb-ead3-44c7-a5e5-fb0b3f15cb91", "private", [], [], %{"baseDamage" => "4.0", "baseFireRate" => "0.089", "critChance" => "0.25", "critMult" => "2.0", "damageChain" => ["stat_dmg", "floor_dmg", "doomblaster", "slide", "dash", "headshot", "crit"], "fireMode" => "hitscan", "headshotMult" => "4.0", "maxRange" => "100.0", "title" => "Machine Gun"}, [], %{}, %{}, false, %{}, ~U[2026-10-13 19:47:24.192242Z], ~U[2026-10-13 19:47:24.192242Z], "4a27add9-a8db-4c84-bd75-3ceac87a1223"]
