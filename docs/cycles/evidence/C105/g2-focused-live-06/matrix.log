 => "freezeEnemies", "title" => "Freeze enemies", "type" => "boolean"}, %{"description" => "How long a TIMED state holds before auto-restoring to NORMAL (counted down on real dt in tick). 0 means hold until explicitly changed (NORMAL / FROZEN are held, not timed).", "name" => "duration", "title" => "Duration (real seconds)", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}, %{"description" => "Exponential ease rate (per real second) driving slow_motion_scale toward the target on entry. SLOW_LERP_RATE is 8.0 for normal eases; HIT_STOP SNAPS instead (no ease) because its ~60 ms window is far shorter than the ~1/8 s ease time-constant.", "name" => "easeIn", "title" => "Ease-in rate", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}, %{"description" => "Exponential ease rate (per real second) ramping slow_motion_scale back toward 1.0 when the state releases. SLOW_LERP_RATE is 8.0 — the ease runs on real dt so the transition can never slow itself.", "name" => "easeOut", "title" => "Ease-out rate", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}], false, "document", [], "production", [], "moon", [], "private", [], [], %{"duration" => "0", "easeIn" => "8.0", "easeOut" => "8.0", "enemyScale" => "1.2", "freezeEnemies" => false, "physicsScale" => "1.2", "playerScale" => "1.0", "slug" => "normal", "title" => "NORMAL"}, [], %{}, %{}, false, %{}, ~U[2026-10-13 19:47:24.171005Z], ~U[2026-10-13 19:47:24.171005Z], "afb60ddb-bfb2-4ca5-8e72-059a9e4a4409"]
