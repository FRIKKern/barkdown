rystal_collected', 'wave_manager telegraph'.", "name" => "triggerSignal", "title" => "Trigger / spawn call", "type" => "string"}], false, "document", [], "db91ad5f-3bbe-498d-8ed8-9764a8959396", "d08684a3-edfe-411c-aa4a-2b592f46269b", "production", [], "image", [], "148a5cbb-ead3-44c7-a5e5-fb0b3f15cb91", "private", [], [], %{"family" => "gpu_particles", "lifetime" => "0.4", "poolSize" => "16"}, [], %{}, %{}, false, %{}, ~U[2026-10-13 19:47:24.269448Z], ~U[2026-10-13 19:47:24.269448Z], "e6405d83-e641-4317-ba0b-6b07650c31e2"]
