2026-10-13T16:06:48.9688558Z  2026-10-13 16:02:05.073 UTC [548] STATEMENT:  DO $$
2026-10-13T16:06:48.9688644Z  	BEGIN
2026-10-13T16:06:48.9688732Z  	  IF EXISTS (
2026-10-13T16:06:48.9688882Z  	    SELECT 1
2026-10-13T16:06:48.9688979Z  	    FROM cycle_waves wave
2026-10-13T16:06:48.9689064Z  	    WHERE CASE
2026-10-13T16:06:48.9689296Z  	      WHEN jsonb_typeof(to_jsonb(wave.inventory)) IS DISTINCT FROM 'array' THEN true
2026-10-13T16:06:48.9689386Z  	      ELSE
2026-10-13T16:06:48.9689472Z  	        EXISTS (
2026-10-13T16:06:48.9689556Z  	          SELECT 1
2026-10-13T16:06:48.9689753Z  	          FROM jsonb_array_elements(to_jsonb(wave.inventory)) inventory_unit
2026-10-13T16:06:48.9690009Z  	          WHERE jsonb_typeof(inventory_unit) <> 'object' OR
2026-10-13T16:06:48.9690222Z  	                jsonb_typeof(inventory_unit->'unit_id') IS DISTINCT FROM 'string' OR
2026-10-13T16:06:48.9690359Z  	                btrim(inventory_unit->>'unit_id') = '' OR
2026-10-13T16:06:48.9690548Z  	                btrim(inventory_unit->>'unit_id') <> inventory_unit->>'unit_id'
2026-10-13T16:06:48.9690636Z  	        ) OR
2026-10-13T16:06:48.9690718Z  	        (
2026-10-13T16:06:48.9690814Z  	          SELECT count(*)
2026-10-13T16:06:48.9690970Z  	          FROM jsonb_array_elements(to_jsonb(wave.inventory))
2026-10-13T16:06:48.9691050Z  	        ) <> (
2026-10-13T16:06:48.9691195Z  	          SELECT count(DISTINCT inventory_unit->>'unit_id')
2026-10-13T16:06:48.9691442Z  	          FROM jsonb_array_elements(to_jsonb(wave.inventory)) inventory_unit
2026-10-13T16:06:48.9691527Z  	        ) OR
2026-10-13T16:06:48.9691639Z  	        (wave.profile = 'legendary' AND
2026-10-13T16:06:48.9691788Z  	         jsonb_array_length(to_jsonb(wave.inventory)) < 15)
2026-10-13T16:06:48.9691873Z  	    END
2026-10-13T16:06:48.9691956Z  	  ) THEN
2026-10-13T16:06:48.9692530Z  	    RAISE EXCEPTION 'cannot install cycle wave inventory retrofit: existing inventory is malformed, padded, duplicate, or below the legendary floor'
2026-10-13T16:06:48.9692647Z  	      USING ERRCODE = 'check_violation';
