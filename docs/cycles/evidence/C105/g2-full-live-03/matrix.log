~U[2026-10-13 18:22:12.146220Z], "bd330189-c5fa-4176-aff0-f21fae0a8d0e", "2ae3b248-ed08-4739-b30d-6025085f1db7", "Carries other text associated with toy safety", "Exact text (not in itself a warning) must be included in <ProductFormFeatureDescription>. May be used either without any warning, or as text additional to a warning. Note that if no warnings apply, code 00 can provide positive indication of this. Example uses: ‘Suitable for all ages’ or ‘Adult supervision required’", "eng", ~U[2026-10-13 18:22:12.146220Z], ~U[2026-10-13 18:22:12.146220Z], "21f5d85e-6c31-406f-a084-0d90d02585a1", "8ba58639-5c7f-4875-ab80-5cb7e82b767e", "Material Safety Data Sheet available", "Material Safety Data Sheet (a document required by the EU Toy Safety Directive) available online, typically as a PDF file or similar. <ProductFormFeatureDescription> must carry the URL of the document", "eng", ~U[2026-10-13 18:22:12.146220Z], ~U[2026-10-13 18:22:12.146220Z], "87adde09-84c5-48de-90e4-2ab65bf0736c", "bfaef6b8-5067-45ea-9071-62b805c121e2", ...]
