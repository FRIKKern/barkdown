pty for purely additive stats.", "name" => "mult", "title" => "Per-point multiplier term", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}, %{"description" => "Added to a base value per point for additive stats (e.g. stamina +1/pt, crit chance +0.20/pt over base 0.25). Empty for pure multiplier stats.", "name" => "delta", "title" => "Per-point additive delta", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}], "name" => "perPointEffect", "title" => "Per-point effect", "type" => "composite"}, %{"description" => "Emoji or short glyph the level-up card shows for this stat.", "name" => "icon", "title" => "Icon", "type" => "string"}], false, "document", [], "fb88b260-cbfe-4c77-a0b7-8d6a6bda99e6", "4b09495f-5bbb-4586-9157-d4bac46cafc6", "production", [], "settings", [], "eb19c522-33ef-425a-a29b-17d0394229be", "private", [], [], %{"maxPoints" => "5"}, [], %{}, %{}, false, %{}, ~U[2026-10-13 18:22:10.658856Z], ~U[2026-10-13 18:22:10.658856Z], "2efc9553-0c08-4a1b-a2c6-430ba2d1b87f"]
