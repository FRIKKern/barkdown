 => "The player stat this grant allocates a point into (when kind = stat).", "name" => "stat", "refType" => "playerStat", "title" => "Stat granted", "type" => "reference"}, %{"description" => "The rune/perk this grant stacks (when kind = rune).", "name" => "rune", "refType" => "rune", "title" => "Rune granted", "type" => "reference"}], "type" => "composite"}, "ordered" => false, "title" => "Grants", "type" => "arrayOf"}], false, "document", [], "fb88b260-cbfe-4c77-a0b7-8d6a6bda99e6", "4b09495f-5bbb-4586-9157-d4bac46cafc6", "production", [], "layout-list", [], "eb19c522-33ef-425a-a29b-17d0394229be", "private", [], [], %{}, [], %{}, %{}, false, %{}, ~U[2026-10-13 18:22:10.664579Z], ~U[2026-10-13 18:22:10.664579Z], "182ec11e-5b22-4bf5-947d-cad03acc1854"]
