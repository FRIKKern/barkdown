nt-gated.", "name" => "count", "title" => "Count (uses)", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}], "name" => "cost", "title" => "Cost", "type" => "composite"}, %{"description" => "Movement-speed multiplier applied while the ability is active (e.g. focus-dash ×4, slide opens at SLIDE_SPEED 13). 1.0 = no change.", "name" => "speedMult", "title" => "Speed multiplier", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}, %{"description" => "Additive camera FOV change while active (e.g. aim −10 from base 75 to 65, slide +15 to 90). Source camera_rig.gd FOV_* consts.", "name" => "fovDelta", "title" => "FOV delta (deg)", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}, %{"description" => "Fractional bonus to gun damage while the ability is active (e.g. slide +0.25, dash +0.40). 0 = no bonus.", "name" => "damageBonus", "title" => "Damage bonus (fraction)", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}, %{"description" => "How long the ability's effect lasts (e.g. focus-dash 0.5s, super-jump free slowmo 3.0s). 0 for instantaneous / held abilities.", "name" => "duration", "title" => "Duration (s)", "type" => "string", "validation" => %{"pattern" => "^-?[0-9]+(\\.[0-9]+)?$"}}, %{"description" => "The GameClock time state this ability drives, if any (e.g. focus-dash → FOCUS_DASH 0.25× scale, bullet-time → SLOW_MO). References the timeState schema.", "name" => "usesTimeState", "refType" => "timeState", "title" => "Uses time state", "type" => "reference"}], false, "document", [], "5c1e623e-865d-481e-bb7f-1264b25aa6a0", "e16c05fc-b360-43f2-9609-01c5f240f66a", "production", [], "activity", [], "69116f3e-4de6-429c-8362-b5e6ec8e1977", "private", [], [], %{}, [], %{}, %{}, false, %{}, ~U[2026-10-13 18:36:41.503287Z], ~U[2026-10-13 18:36:41.503287Z], "c69961a0-dd3a-4e12-a641-739b3ca319a7"]
