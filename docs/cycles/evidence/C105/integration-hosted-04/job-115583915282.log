2026-10-13T22:59:41.6481762Z 22:59:41.645 [info] execute "\nCREATE TRIGGER reserve_media_object_delete_v1 AFTER DELETE ON public.media_files\n  FOR EACH ROW EXECUTE FUNCTION public.reserve_media_object_v1();\n"
