2026-10-13T22:39:29.3424874Z 22:39:29.342 [info] execute "CREATE OR REPLACE FUNCTION barkpark_epic_ledger_immutable()\nRETURNS trigger AS $$\nBEGIN\n  IF TG_OP = 'DELETE' AND pg_trigger_depth() > 1 THEN\n    RETURN OLD;\n  END IF;\n\n  RAISE EXCEPTION '% is append-only (% forbidden)', TG_TABLE_NAME, TG_OP;\nEND;\n$$ LANGUAGE plpgsql;\n"
