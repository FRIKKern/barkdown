{"file":"bin/icutu77.dll","strings":[{"offset":292672,"text":"icupkg: \"%s\" is not recognized as a package filename (must end with .dat)"},{"offset":292752,"text":"icupkg: the package name \"%s\" is too long (>=%ld)"},{"offset":292872,"text":"icupkg: unable to create tree directory \"%s\""},{"offset":292928,"text":"icupkg: unable to open input file \"%s\""},{"offset":292968,"text":"icupkg: empty input file \"%s\""},{"offset":293000,"text":"icupkg: malloc error allocating %d bytes."},{"offset":293048,"text":"icupkg: error reading \"%s\""},{"offset":293080,"text":"icupkg: not an ICU data file: \"%s\""},{"offset":293120,"text":"icupkg: --toc_prefix %s too long"},{"offset":293160,"text":"icupkg: udata_openSwapper(\"%s\") failed - %s"},{"offset":293216,"text":"icupkg: data format %02x.%02x.%02x.%02x (format version %02x) is not recognized as an ICU .dat package"},{"offset":293320,"text":"icupkg: too few bytes (%ld after header) for a .dat package"},{"offset":293392,"text":"icupkg: --auto_toc_prefix[_with_type] but the input package is empty"},{"offset":293464,"text":"icupkg: too many items, maximum is %d"},{"offset":293504,"text":"icupkg: total length of item name strings too long"},{"offset":293568,"text":"icupkg failed to swap the input .dat package item name strings"},{"offset":293632,"text":"icupkg: --auto_toc_prefix[_with_type] but the first entry \"%s\" does not contain a '%c'"},{"offset":293728,"text":"icupkg: --auto_toc_prefix[_with_type] but the prefix of the first entry \"%s\" is empty or too long"},{"offset":293840,"text":"icupkg: --auto_toc_prefix_with_type but the prefix of the first entry \"%s\" does not end with '%c'"},{"offset":293944,"text":"icupkg: input .dat item name \"%s\" does not start with \"%s\""},{"offset":294008,"text":"icupkg: not an ICU data file: item \"%s\" in \"%s\""},{"offset":294064,"text":"icupkg: comment too long"},{"offset":294096,"text":"icupkg: udata_openSwapper() failed - %s"},{"offset":294144,"text":"icupkg: unable to create file