09:29:06.610 [info] execute "CREATE TRIGGER epic_assignments_reject_sealed_append\nBEFORE INSERT ON epic_assignments\nFOR EACH ROW EXECUTE FUNCTION barkpark_reject_sealed_cycle_append();\n"
