SING ERRCODE = 'check_violation';\n    END IF;\n  ELSE\n    SELECT COALESCE(\n      (SELECT (plan->NEW.phase->>'planned')::integer\n       FROM cycle_build_plans WHERE wave_id = NEW.cycle_wave_id),\n      (SELECT (plan->NEW.phase-" <> ...
